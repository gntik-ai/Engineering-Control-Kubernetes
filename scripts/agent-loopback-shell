#!/usr/bin/python3 -IS
"""NEW-228: the CLAUDE_CODE_SHELL_PREFIX of loopback-enabled Claude runs.

Claude Code runs every Bash tool command as `<this script> '<command string>'`. The
command runs under bubblewrap in a network namespace of its own whose only interface is
lo (127.0.0.1 and ::1): a test can bind and connect on loopback (vite preview, Playwright
and Chromium); no other address is reachable (internet, LAN, this host's addresses and its
loopback services, metadata IPs). Abstract unix sockets belong to the network namespace.

A pathname unix socket crosses network namespaces, so the command sees a filesystem view
built here that holds no host socket file (review 2, finding 1): read-only system trees
(/usr, the browser and toolchain roots under /opt, an allowlist of /etc without the worker
credentials), the run's own directories (the provider worker names them, this ChangeSet's
Git metadata included, in HERMES_LOOPBACK_WRITABLE / HERMES_LOOPBACK_READABLE, pinned in
--settings; every bind source is resolved and checked), a minimal /dev, a /proc of its
own PID namespace (no /proc/<host pid>/{environ,root,cwd,fd}: the Claude CLI's environment
holds its credentials) with systemd's ProtectKernelTunables= /proc table re-applied (the
worker unit cannot apply it: see PROC_READ_ONLY) and fresh tmpfs mounts for /run, /tmp (the
run's TMPDIR when it has one), /var/tmp, /dev/shm and the home (only the shell snapshots
Claude sources, the git configuration and the Playwright browsers come back, read-only).
No /sys, /srv, /var or /home otherwise.
A seccomp filter refuses io_uring and x32 system calls, and no descriptor but stdio
reaches the command. Unix sockets made inside (Chrome's singleton, socketpair) connect
only to processes inside. Same user, so no write is added. The Claude CLI keeps its own
API connection. Installed root-owned with the release: it runs outside the namespace, so
the provider worker refuses it while the runner could modify it.
"""

import os
import pwd
import stat
import struct
import sys

BWRAP = "/usr/bin/bwrap"
AUDIT_ARCH_X86_64 = 0xC000003E
SYSCALL_IO_URING_SETUP = 425
X32_SYSCALL_BIT = 0x40000000
RET_KILL_PROCESS = 0x80000000
RET_ALLOW = 0x7FFF0000
RET_EPERM = 0x00050000 | 1
LOAD, JEQ, JSET, RET = 0x20, 0x15, 0x45, 0x06  # BPF_LD|W|ABS, JMP|JEQ|K, JMP|JSET|K, RET|K
# struct seccomp_data: nr at 0, arch at 4. No AF_UNIX rule: Chrome's process singleton
# needs socket(AF_UNIX) (headless Chrome aborts without it); the filesystem view is what
# keeps host unix sockets out of reach.
PROGRAM = (
    (LOAD, 0, 0, 4),
    (JEQ, 1, 0, AUDIT_ARCH_X86_64),
    (RET, 0, 0, RET_KILL_PROCESS),
    (LOAD, 0, 0, 0),
    (JSET, 2, 0, X32_SYSCALL_BIT),
    (JEQ, 1, 0, SYSCALL_IO_URING_SETUP),
    (RET, 0, 0, RET_ALLOW),
    (RET, 0, 0, RET_EPERM),
)
# Read-only system trees; /bin, /lib... are bound as they are (merged-/usr symlinks stay
# symlinks). Nothing under /run, /var, /srv or /home.
SYSTEM_TREES = ("/usr", "/opt/engineering-browser", "/opt/engineering-toolchain")
SYSTEM_LINKS = ("/bin", "/sbin", "/lib", "/lib32", "/lib64", "/libx32")
# Of /etc only what the C library, git, Node.js, Python, pnpm and Chromium read (review 3,
# finding 1): never /etc/engineering-control (worker credentials, tokens) or another
# service's configuration. A symlink entry is recreated as the same symlink (it resolves
# inside the view: /etc/resolv.conf's target under /run does not exist there).
ETC_ENTRIES = (
    "passwd", "group", "nsswitch.conf", "hosts", "host.conf", "gai.conf", "resolv.conf",
    "services", "protocols", "localtime", "timezone", "ld.so.cache", "ld.so.conf",
    "ld.so.conf.d", "alternatives", "ssl/certs", "ssl/openssl.cnf", "ca-certificates",
    "ca-certificates.conf", "fonts", "gitconfig", "mime.types", "os-release", "lsb-release",
    "debian_version", "bash.bashrc", "profile", "profile.d", "inputrc", "environment",
    "locale.alias", "default/locale", "mtab", "shells", "terminfo", "magic", "magic.mime",
)
# What comes back of the home, read-only (relative path, the type it must have).
HOME_ENTRIES = ((".gitconfig", "file"), (".config/git", "dir"), (".cache/ms-playwright", "dir"))
# Fresh, size-capped tmpfs mounts (MiB).
SCRATCH = (("/tmp", 2048), ("/var/tmp", 1024), ("/run", 16), ("/dev/shm", 1024))
HOME_TMPFS_MIB = 1024
# systemd's ProtectKernelTunables= /proc table (src/core/namespace.c), re-applied inside
# over the sandbox's own procfs. The claude worker unit sets ProtectKernelTunables=false
# (systemd/engineering-worker@claude.service.d/70-loopback-proc.conf): its mounts over
# /proc are locked in bubblewrap's user namespace, and the kernel then refuses any new
# procfs (mount_too_revealing: "Can't mount proc on /newroot/proc: Operation not
# permitted", gntik-ui #247, 2026-10-22). Bound from the worker's /proc (same kernel);
# /proc/sys shows the sysctls of the reader's own namespaces.
PROC_READ_ONLY = (
    "acpi", "apm", "asound", "bus", "fs", "irq", "latency_stats", "mtrr", "scsi", "sys",
    "sysrq-trigger", "timer_stats",
)
PROC_MASKED = ("kallsyms", "kcore")  # /dev/null on a nodev mount: every open fails
# Mounts the kernel accepts below the worker's /proc (permanently empty directories).
PROC_SUBMOUNTS_ALLOWED = ("/proc/sys/fs/binfmt_misc", "/proc/fs/nfsd")
# Never bound from the environment or the home: kernel and runtime trees (their sockets),
# /etc (credentials), the roots holding everyone's temp files, and the home (or an
# ancestor of it) as a whole.
FORBIDDEN_TREES = ("/proc", "/sys", "/dev", "/run", "/var/run", "/etc", "/root")
FORBIDDEN_EXACT = ("/", "/tmp", "/var/tmp", "/var", "/srv", "/home", "/usr", "/opt")


def fail(message: str) -> None:
    print(f"agent-loopback-shell: {message}", file=sys.stderr)
    sys.exit(126)


def within(path: str, tree: str) -> bool:
    return path == tree or path.startswith(tree.rstrip("/") + "/")


def forbidden(path: str, home: str) -> bool:
    return (
        path in FORBIDDEN_EXACT
        or within(home, path)
        or any(within(path, tree) for tree in FORBIDDEN_TREES)
    )


def kind(info: os.stat_result) -> str:
    return "dir" if stat.S_ISDIR(info.st_mode) else "file" if stat.S_ISREG(info.st_mode) else ""


def exact_source(path: str, expected: str, home: str) -> bool:
    """A home or configuration entry to bind (review 3, finding 3): False if absent; the
    run is refused if any component is a symlink (a redirect to /run, or to the real
    home), if it has another type, or if it is under a forbidden tree."""
    prefix = "/"
    for part in os.path.normpath(path).split("/")[1:]:
        prefix = os.path.join(prefix, part)
        if os.path.islink(prefix):  # even one whose target is missing: fail closed
            fail(f"{path} is reached through a symlink ({prefix})")
    if not os.path.lexists(path):
        return False
    if os.path.realpath(path) != os.path.normpath(path):
        fail(f"{path} is reached through a symlink")
    if kind(os.lstat(path)) != expected:
        fail(f"{path} is not a {expected}")
    if forbidden(path, home):
        fail(f"{path} is under a forbidden tree")
    return True


def checked_root(raw: str, home: str) -> str | None:
    """A directory from HERMES_LOOPBACK_*: absolute, existing, and not a forbidden tree."""
    if not raw.startswith("/"):
        fail(f"root {raw!r} is not absolute")
    path = os.path.realpath(raw)
    if not os.path.isdir(path):
        return None  # e.g. no mirror root on this host
    if forbidden(path, home):
        fail(f"root {path} is too broad or under a forbidden tree")
    return path


def roots(name: str, home: str) -> list[str]:
    found = []
    for raw in os.environ.get(name, "").split(":"):
        if raw:
            path = checked_root(raw, home)
            if path is not None and path not in found:
                found.append(path)
    return found


def arguments(home: str, seccomp_fd: int, command: str) -> list[str]:
    argv = [
        BWRAP,
        "--unshare-net",
        "--unshare-pid",
        "--unshare-ipc",
        "--die-with-parent",
        "--new-session",
    ]
    for tree in SYSTEM_TREES:
        # A release symlink (/opt/engineering-browser -> a versioned directory) is followed,
        # but never into a forbidden tree or the home.
        if os.path.isdir(tree):
            source = os.path.realpath(tree)
            if forbidden(source, home) and source != tree:
                fail(f"{tree} resolves to {source}")
            argv += ["--ro-bind", source, tree]
    for link in SYSTEM_LINKS:
        if os.path.islink(link):
            argv += ["--symlink", os.readlink(link), link]
        elif os.path.isdir(link):
            argv += ["--ro-bind", link, link]
    argv += ["--dir", "/etc"]
    for name in ETC_ENTRIES:
        entry = os.path.join("/etc", name)
        if os.path.islink(entry):
            argv += ["--symlink", os.readlink(entry), entry]
        elif os.path.lexists(entry):
            if os.path.realpath(entry) != entry or kind(os.lstat(entry)) not in ("dir", "file"):
                fail(f"{entry} is not a plain file or directory")
            argv += ["--ro-bind", entry, entry]
    argv += ["--dev", "/dev", "--proc", "/proc"]
    for name in PROC_READ_ONLY:
        entry = os.path.join("/proc", name)
        if os.path.lexists(entry):
            argv += ["--ro-bind", entry, entry]
    for name in PROC_MASKED:
        entry = os.path.join("/proc", name)
        if os.path.lexists(entry):
            argv += ["--ro-bind", "/dev/null", entry]
    readable = roots("HERMES_LOOPBACK_READABLE", home)
    writable = roots("HERMES_LOOPBACK_WRITABLE", home)
    # The run's TMPDIR (NEW-226, on disk, removed with the run) is /tmp inside too: Chrome's
    # SingletonSocket under a long TMPDIR passes the 107-byte unix path limit and aborts.
    temp = os.environ.get("TMPDIR", "")
    run_temp = os.path.realpath(temp) if temp.startswith("/") else None
    if run_temp not in writable:
        run_temp = None
    for path, mib in SCRATCH:
        if path == "/tmp" and run_temp is not None:
            argv += ["--bind", run_temp, "/tmp"]
            for name in ("TMPDIR", "TMP", "TEMP"):
                argv += ["--setenv", name, "/tmp"]
        else:
            argv += ["--size", str(mib * 1024 * 1024), "--tmpfs", path]
    argv += ["--perms", "0700", "--size", str(HOME_TMPFS_MIB * 1024 * 1024), "--tmpfs", home]
    configuration = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(home, ".claude")
    if not configuration.startswith("/"):
        fail("CLAUDE_CONFIG_DIR is not absolute")
    entries = [(os.path.join(configuration, "shell-snapshots"), "dir")]
    entries += [(os.path.join(home, name), expected) for name, expected in HOME_ENTRIES]
    for entry, expected in entries:
        if exact_source(entry, expected, home):
            argv += ["--ro-bind", entry, entry]
    for path in readable:
        argv += ["--ro-bind", path, path]
    for path in writable:  # after the read-only roots: a run directory inside one stays writable
        argv += ["--bind", path, path]
    cwd = os.getcwd()
    if any(within(cwd, path) for path in (*readable, *writable)):
        argv += ["--chdir", cwd]
    argv += ["--seccomp", str(seccomp_fd), "--", "/bin/bash", "-c", command]
    return argv


def proc_overmounts(mountinfo: str = "/proc/self/mountinfo") -> list[str]:
    """Mounts below this process's /proc: locked in bubblewrap's user namespace, they make
    the kernel refuse the sandbox's own procfs."""
    with open(mountinfo, encoding="utf-8") as handle:
        points = [line.split()[4] for line in handle if len(line.split()) > 4]
    return [
        point
        for point in points
        if point.startswith("/proc/") and point not in PROC_SUBMOUNTS_ALLOWED
    ]


def main() -> None:
    if len(sys.argv) != 2:
        fail("expected exactly one command string")
    if os.uname().machine != "x86_64":
        fail("only x86_64 is supported")
    covered = proc_overmounts()
    if covered:  # bubblewrap decides; this names the likely cause of its refusal
        print(
            f"agent-loopback-shell: mounts over /proc ({', '.join(sorted(set(covered))[:4])})"
            " make the kernel refuse bubblewrap's own /proc; the worker unit needs"
            " ProtectKernelTunables=false (engineering-worker@claude.service.d/"
            "70-loopback-proc.conf)",
            file=sys.stderr,
        )
    home = pwd.getpwuid(os.getuid()).pw_dir
    if not home.startswith("/") or not os.path.isdir(home) or within(home, "/run"):
        fail(f"no usable home directory for uid {os.getuid()}")
    home = os.path.realpath(home)
    program = b"".join(struct.pack("<HBBI", *instruction) for instruction in PROGRAM)
    read_end, write_end = os.pipe()
    os.write(write_end, program)  # far below the pipe buffer
    os.close(write_end)
    argv = arguments(home, read_end, sys.argv[1])
    # No descriptor the CLI leaked (a socket connected outside, say) reaches the command.
    os.closerange(3, read_end)
    os.closerange(read_end + 1, os.sysconf("SC_OPEN_MAX"))
    os.set_inheritable(read_end, True)
    os.execv(BWRAP, argv)


if __name__ == "__main__":
    main()
