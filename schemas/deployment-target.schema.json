{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering.gntik.ai/schemas/deployment-target.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "enabled",
    "project",
    "environment",
    "strategy",
    "target_context",
    "target_namespace",
    "configuration"
  ],
  "properties": {
    "version": {"const": 1},
    "enabled": {"type": "boolean"},
    "project": {"enum": ["falcone", "musematic"]},
    "environment": {"enum": ["preview", "staging"]},
    "strategy": {"enum": ["helm", "argocd-gitops"]},
    "target_context": {"type": "string", "minLength": 1, "maxLength": 253},
    "target_namespace": {"type": "string", "minLength": 1, "maxLength": 253},
    "blocker": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chart_subdirectory": {"type": "string", "minLength": 1, "maxLength": 300},
        "values_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        },
        "chart_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "release_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,52}$"
        },
        "kube_context": {"type": "string", "minLength": 1, "maxLength": 253},
        "kubeconfig_path": {
          "type": "string",
          "pattern": "^/etc/engineering-control/env/release/[^/]+$",
          "maxLength": 500
        },
        "timeout_minutes": {"type": "integer", "minimum": 5, "maximum": 120},
        "argo_application": {"type": "string", "minLength": 1, "maxLength": 253}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"project": {"const": "falcone"}}, "required": ["project"]},
      "then": {"properties": {"strategy": {"const": "helm"}}}
    },
    {
      "if": {"properties": {"project": {"const": "musematic"}}, "required": ["project"]},
      "then": {"properties": {"strategy": {"const": "argocd-gitops"}}}
    },
    {
      "if": {"properties": {"enabled": {"const": false}}, "required": ["enabled"]},
      "then": {"required": ["blocker"]}
    },
    {
      "if": {
        "properties": {
          "enabled": {"const": true},
          "strategy": {"const": "helm"}
        },
        "required": ["enabled", "strategy"]
      },
      "then": {
        "properties": {
          "target_context": {"not": {"const": "UNCONFIGURED"}},
          "target_namespace": {
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          },
          "configuration": {
            "required": [
              "values_files",
              "release_name",
              "kube_context",
              "kubeconfig_path"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "enabled": {"const": true},
          "strategy": {"const": "argocd-gitops"}
        },
        "required": ["enabled", "strategy"]
      },
      "then": {
        "properties": {
          "target_context": {"not": {"const": "UNCONFIGURED"}},
          "target_namespace": {
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          },
          "configuration": {"required": ["argo_application"]}
        }
      }
    }
  ]
}
