{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering.gntik.ai/schemas/recovery-plan.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "deployment_id",
        "change_set_id",
        "release_name",
        "namespace",
        "kube_context",
        "kubeconfig_path",
        "previous_revision",
        "previous_manifest_sha256",
        "original_artifact_binding_sha256",
        "recovery_approval_binding_sha256",
        "timeout_minutes"
      ],
      "properties": {
        "strategy": {"const": "helm"},
        "deployment_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "change_set_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "release_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,52}$"},
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "kube_context": {"type": "string", "minLength": 1, "maxLength": 160},
        "kubeconfig_path": {
          "type": "string",
          "pattern": "^/etc/engineering-control/env/release/[^/]+$"
        },
        "previous_revision": {"type": "integer", "minimum": 1},
        "previous_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "original_artifact_binding_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recovery_approval_binding_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "timeout_minutes": {"type": "integer", "minimum": 5, "maximum": 120}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "deployment_id",
        "change_set_id",
        "deployment_repository",
        "failed_revision",
        "revert_target_revision",
        "target_context",
        "target_namespace",
        "original_artifact_binding_sha256",
        "required_path"
      ],
      "properties": {
        "strategy": {"const": "argocd-gitops"},
        "deployment_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "change_set_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "deployment_repository": {"const": "musematic-deploy"},
        "failed_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "revert_target_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "target_context": {"type": "string", "minLength": 1, "maxLength": 160},
        "target_namespace": {"type": "string", "minLength": 1, "maxLength": 63},
        "original_artifact_binding_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "required_path": {"const": "protected-deployment-repository-pr"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "deployment_id",
        "change_set_id",
        "reason",
        "original_artifact_binding_sha256"
      ],
      "properties": {
        "strategy": {"const": "helm-forward-recovery"},
        "deployment_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "change_set_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "reason": {"const": "MIGRATION_FORWARD_RECOVERY_REQUIRED"},
        "original_artifact_binding_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  ]
}
