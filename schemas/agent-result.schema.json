{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering.gntik.ai/schemas/agent-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "decision", "evidence", "open_questions"],
  "properties": {
    "summary": {"type": "string", "maxLength": 20000},
    "decision": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "REQUEST_CHANGES"]},
    "evidence": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference", "sha256"],
        "properties": {
          "kind": {"type": "string"},
          "reference": {"type": "string"},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string"}}
  }
}
