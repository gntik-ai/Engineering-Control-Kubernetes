{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering.gntik.ai/schemas/runtime-target.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "enabled",
    "project",
    "environment",
    "target_context",
    "target_namespace",
    "configuration"
  ],
  "properties": {
    "version": {"const": 1},
    "enabled": {"type": "boolean"},
    "project": {"enum": ["falcone", "musematic"]},
    "environment": {"const": "staging"},
    "target_context": {"type": "string", "minLength": 1, "maxLength": 160},
    "target_namespace": {"type": "string", "minLength": 1, "maxLength": 160},
    "blocker": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,119}$"},
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observer_kubeconfig_path": {
          "type": "string",
          "pattern": "^/etc/engineering-control/env/observer/[^/]+$"
        },
        "observed_resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "pods",
              "deployments",
              "statefulsets",
              "daemonsets",
              "jobs",
              "applications.argoproj.io",
              "externalsecrets.external-secrets.io"
            ]
          }
        },
        "revision_annotation": {"type": "string", "minLength": 1, "maxLength": 253},
        "argo_application": {"type": "string", "minLength": 1, "maxLength": 253},
        "journey_plan_path": {
          "type": "string",
          "pattern": "^/etc/engineering-control/journeys/[^/]+\\.json$"
        },
        "browser_credential_file": {
          "type": ["string", "null"],
          "pattern": "^/etc/engineering-control/env/browser/[^/]+\\.env$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"enabled": {"const": false}}, "required": ["enabled"]},
      "then": {"required": ["blocker"], "properties": {"configuration": {"maxProperties": 0}}}
    },
    {
      "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
      "then": {
        "properties": {
          "target_context": {"not": {"const": "UNCONFIGURED"}},
          "target_namespace": {
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          },
          "configuration": {
            "required": [
              "observer_kubeconfig_path",
              "observed_resources",
              "journey_plan_path"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "enabled": {"const": true},
          "project": {"const": "falcone"}
        },
        "required": ["enabled", "project"]
      },
      "then": {"properties": {"configuration": {"required": ["revision_annotation"]}}}
    },
    {
      "if": {
        "properties": {
          "enabled": {"const": true},
          "project": {"const": "musematic"}
        },
        "required": ["enabled", "project"]
      },
      "then": {"properties": {"configuration": {"required": ["argo_application"]}}}
    }
  ]
}
