[Unit]
Description=Engineering Control private API
After=engineering-migrate.service
Requires=engineering-migrate.service

[Service]
Type=simple
User=engineering-control
Group=engineering-control
WorkingDirectory=/var/lib/engineering-control
EnvironmentFile=/etc/engineering-control/env/control.env
ExecStart=/opt/engineering-control/venv/bin/engineering-api
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/engineering-control /srv/engineering/evidence
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
