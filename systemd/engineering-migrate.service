[Unit]
Description=Engineering Control database migrations
After=engineering-infrastructure.service
Requires=engineering-infrastructure.service

[Service]
Type=oneshot
User=engineering-control
Group=engineering-control
WorkingDirectory=/opt/engineering-control/source
EnvironmentFile=/etc/engineering-control/env/control.env
ExecStart=/opt/engineering-control/venv/bin/alembic -c /opt/engineering-control/source/alembic.ini upgrade head
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/engineering-control
