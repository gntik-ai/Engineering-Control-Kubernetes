# Opt-in drop-in: allow the notifier to reach ONE remote HTTPS bearer sink.
#
# The default engineering-notifier.service is confined to loopback
# (IPAddressDeny=any + IPAddressAllow=localhost) because the production sink is the
# Hermes gateway webhook on 127.0.0.1:8644 (ENGINEERING_NOTIFICATION_AUTH_MODE=hmac-sha256-v2).
# Install this only when control.env configures
#   ENGINEERING_NOTIFICATION_AUTH_MODE=bearer
#   ENGINEERING_NOTIFICATION_SINK_URL=https://<sink-host>/<path>
# The notifier itself already refuses a bearer sink that is not credential-free HTTPS.
#
# Install (root):
#   install -d -m 0755 /etc/systemd/system/engineering-notifier.service.d
#   install -m 0644 remote-bearer-sink.conf.example \
#     /etc/systemd/system/engineering-notifier.service.d/remote-bearer-sink.conf
#   edit the IPAddressAllow line below, then:
#   systemctl daemon-reload && systemctl restart engineering-notifier.service
#
# Replace the placeholder with the sink's exact address(es), one /32 (IPv4) or /128
# (IPv6) per resolved address. systemd matches addresses, not host names; name
# resolution keeps working through the loopback resolver already allowed by the unit.
# Do not add IPAddressDeny= or IPAddressAllow=any: the deny-by-default stays in force.
[Service]
IPAddressAllow=192.0.2.1/32
