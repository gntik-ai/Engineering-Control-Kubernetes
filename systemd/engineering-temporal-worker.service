[Unit]
Description=Engineering Control Temporal orchestration worker
After=engineering-migrate.service
Requires=engineering-migrate.service

[Service]
Type=simple
User=engineering-control
Group=engineering-control
WorkingDirectory=/var/lib/engineering-control
EnvironmentFile=/etc/engineering-control/env/control.env
Environment=ENGINEERING_WORKER_KIND=controller
ExecStart=/opt/engineering-control/venv/bin/engineering-worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/engineering-control /srv/engineering/evidence
MemoryMax=768M
CPUQuota=150%

[Install]
WantedBy=multi-user.target
