[Unit]
Description=Engineering Control notification outbox service
After=engineering-migrate.service
Requires=engineering-migrate.service

[Service]
Type=simple
User=engineering-control
Group=engineering-control
WorkingDirectory=/var/lib/engineering-control
EnvironmentFile=/etc/engineering-control/env/control.env
ExecStart=/opt/engineering-control/venv/bin/engineering-notifier
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/engineering-control
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
