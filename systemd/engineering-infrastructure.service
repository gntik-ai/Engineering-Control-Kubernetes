[Unit]
Description=Engineering Control Temporal and PostgreSQL infrastructure
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/engineering-control/infrastructure
ExecStart=/usr/bin/docker compose --env-file /etc/engineering-control/env/infrastructure.env up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /etc/engineering-control/env/infrastructure.env stop
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
