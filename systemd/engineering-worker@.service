[Unit]
Description=Engineering Control bounded %i worker
After=network-online.target
Wants=network-online.target

[Service]
# NEW-232: the worker pings WATCHDOG=1 from its event loop; a stalled loop is aborted
# (SIGABRT, so faulthandler writes every thread's stack to the journal) and restarted.
# 10 minutes tolerates the bounded synchronous work some activities still do on the loop
# (browser evidence uploads, 60 s each); the stalls this catches lasted over an hour.
# Startup removes stale run directories before READY, so its deadline stays unbounded.
Type=notify
NotifyAccess=main
WatchdogSec=600
TimeoutStartSec=infinity
WatchdogSignal=SIGABRT
LimitCORE=0
User=%i-runner
Group=%i-runner
WorkingDirectory=/var/lib/engineering-control/workers/%i
EnvironmentFile=/etc/engineering-control/env/worker-common.env
EnvironmentFile=-/etc/engineering-control/env/evidence-upload.env
EnvironmentFile=-/etc/engineering-control/env/%i-worker.env
Environment=ENGINEERING_WORKER_KIND=%i
Environment=ENGINEERING_EVIDENCE_INGEST_TOKEN_FILE=/etc/engineering-control/env/evidence-%i-runner.token
ExecStart=/opt/engineering-control/venv/bin/engineering-role-worker
Restart=on-failure
RestartSec=8
TimeoutStopSec=60
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/engineering-control/workers/%i /var/lib/engineering-control/identities/%i-runner /var/lib/engineering-control/leases /srv/engineering/mirrors /srv/engineering/worktrees /srv/engineering/runs/%i /srv/engineering/evidence/%i /srv/engineering/cache/%i /srv/engineering/cache/scan/worktree-git /srv/engineering/tmp/%i
# NEW-167: inside the workers\' aggregate memory budget (agents override to their slice).
Slice=engineering-workers.slice
MemoryMax=3G
CPUQuota=250%
TasksMax=512

[Install]
WantedBy=multi-user.target
