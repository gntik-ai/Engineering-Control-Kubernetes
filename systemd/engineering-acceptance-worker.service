[Unit]
Description=Engineering Control bounded synthetic acceptance activity worker
After=engineering-infrastructure.service
Requires=engineering-infrastructure.service

[Service]
Type=simple
User=engineering-control
Group=engineering-control
WorkingDirectory=/var/lib/engineering-control
EnvironmentFile=/etc/engineering-control/env/control.env
ExecStart=/opt/engineering-control/venv/bin/engineering-acceptance-worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=10.10.0.2
ReadWritePaths=/srv/engineering/tmp/acceptance
MemoryMax=384M
CPUQuota=100%
TasksMax=128

[Install]
WantedBy=multi-user.target
