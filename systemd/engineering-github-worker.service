[Unit]
Description=Engineering Control typed GitHub CLI broker worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
SupplementaryGroups=engineering-control
WorkingDirectory=/opt/engineering-control/source
EnvironmentFile=/etc/engineering-control/env/github-worker.env
Environment=HOME=/home/hermes
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=ENGINEERING_WORKER_KIND=github
Environment=ENGINEERING_GITHUB_AUTHENTICATED_HOME=/home/hermes
Environment=ENGINEERING_GITHUB_WRITES_ENABLED=true
Environment=ENGINEERING_GITHUB_ISSUE_WRITE_VALIDATION_FILE=/etc/engineering-control/policy/github-issue-write-validation.yaml
Environment=ENGINEERING_EVIDENCE_INGEST_URL=http://10.10.0.2:8750/v1/evidence
Environment=ENGINEERING_EVIDENCE_INGEST_TOKEN_FILE=/etc/engineering-control/env/evidence-uploaders/github-runner.token
ExecStart=/opt/engineering-control/venv/bin/engineering-role-worker
Restart=on-failure
RestartSec=8
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=/home/hermes/.config/gh /home/hermes/.gitconfig /etc/engineering-control/policy/github-issue-write-validation.yaml
InaccessiblePaths=-/home/hermes/.codex -/home/hermes/.claude -/home/hermes/.ssh -/home/hermes/.kube -/etc/engineering-control/credentials -/etc/engineering-control/env/release
ReadWritePaths=/var/lib/engineering-control/workers/github /srv/engineering/mirrors /srv/engineering/worktrees /srv/engineering/runs /srv/engineering/tmp
MemoryMax=1G
CPUQuota=100%
TasksMax=128

[Install]
WantedBy=multi-user.target
