[Unit]
Description=Engineering Control typed GitHub CLI broker worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/home/hermes
EnvironmentFile=/etc/engineering-control/env/worker-common.env
Environment=ENGINEERING_WORKER_KIND=github
Environment=ENGINEERING_GITHUB_AUTHENTICATED_HOME=/home/hermes
Environment=ENGINEERING_GITHUB_WRITES_ENABLED=false
ExecStart=/opt/engineering-control/venv/bin/engineering-role-worker
Restart=on-failure
RestartSec=8
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=/home/hermes/.config/gh /home/hermes/.gitconfig
ReadWritePaths=/var/lib/engineering-control/workers/github /srv/engineering/mirrors /srv/engineering/worktrees /srv/engineering/runs /srv/engineering/tmp
MemoryMax=1G
CPUQuota=100%
TasksMax=128

[Install]
WantedBy=multi-user.target
