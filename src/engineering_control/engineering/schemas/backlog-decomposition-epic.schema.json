{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "project",
    "inputs",
    "epic",
    "blockers"
  ],
  "properties": {
    "status": {
      "enum": [
        "COMPLETE",
        "BLOCKED"
      ]
    },
    "project": {
      "const": "falcone-serverless"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha",
        "design_sha256",
        "backlog_sha256",
        "issues_sha256",
        "frame_sha256",
        "part_id"
      ],
      "properties": {
        "source_sha": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 40,
              "maxLength": 40,
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "design_sha256": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "backlog_sha256": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "issues_sha256": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "frame_sha256": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "part_id": {
          "type": "string",
          "minLength": 21,
          "maxLength": 21,
          "pattern": "^ep[0-9]{2}-[a-f0-9]{16}$"
        }
      }
    },
    "epic": {
      "anyOf": [
        {
          "$ref": "#/$defs/epic"
        },
        {
          "type": "null"
        }
      ]
    },
    "blockers": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "$defs": {
    "epic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stories"
      ],
      "properties": {
        "stories": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/story"
          },
          "minItems": 1
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "story_id",
        "tasks",
        "story_amendment"
      ],
      "properties": {
        "story_id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 7,
          "pattern": "^[A-Z]{2,4}-[0-9]{2}$"
        },
        "tasks": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/task"
          },
          "minItems": 1
        },
        "story_amendment": {
          "anyOf": [
            {
              "$ref": "#/$defs/story_amendment"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "kind",
        "target",
        "why",
        "what_changes",
        "out_of_scope",
        "acceptance_criteria",
        "requirements",
        "interfaces",
        "test_commands",
        "paths",
        "depends_on",
        "risks",
        "proposed_risk",
        "risk_rationale",
        "size",
        "estimated_files",
        "rollout",
        "kill_switch",
        "open_questions",
        "sources"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 27,
          "maxLength": 30,
          "pattern": "^falcone-serverless:[A-Z]{2,4}-[0-9]{2}\\.t[0-9]{1,2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9._:/@+ =,\"'-]{1,100}$"
        },
        "kind": {
          "enum": [
            "feature",
            "enhancement",
            "bug",
            "chore"
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "role",
                "component"
              ],
              "properties": {
                "repository": {
                  "const": "gntik-ai/falcone-serverless"
                },
                "role": {
                  "const": "source"
                },
                "component": {
                  "enum": [
                    "worker",
                    "controller"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "role",
                "component"
              ],
              "properties": {
                "repository": {
                  "const": "gntik-ai/falcone"
                },
                "role": {
                  "const": "source"
                },
                "component": {
                  "enum": [
                    "functions-api",
                    "quotas",
                    "admission"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "role",
                "component"
              ],
              "properties": {
                "repository": {
                  "const": "gntik-ai/falcone-charts"
                },
                "role": {
                  "const": "deployment"
                },
                "component": {
                  "enum": [
                    "chart"
                  ]
                }
              }
            }
          ]
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "what_changes": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "minItems": 1
        },
        "out_of_scope": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion",
              "covers"
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "covers": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "minLength": 9,
                  "maxLength": 12,
                  "pattern": "^[A-Z]{2,4}-[0-9]{2}#ac[0-9]{1,2}$"
                }
              }
            }
          },
          "minItems": 1
        },
        "requirements": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 19,
            "pattern": "^FR-[A-Za-z0-9][A-Za-z0-9.-]{0,15}$"
          }
        },
        "interfaces": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provides",
            "consumes"
          ],
          "properties": {
            "provides": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 48,
                "pattern": "^ctr-[a-z0-9][a-z0-9-]{0,43}$"
              }
            },
            "consumes": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 48,
                "pattern": "^ctr-[a-z0-9][a-z0-9-]{0,43}$"
              }
            }
          }
        },
        "test_commands": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "minItems": 1
        },
        "paths": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^([A-Za-z0-9_][A-Za-z0-9._-]{0,7}|[A-Za-z0-9_][A-Za-z0-9._-]{9,99}|[0123456789BDEFGHIJKLMNOPQRSTUVWXYZ_bdefghijklmnopqrstuvwxyz][A-Za-z0-9._-]{8}|[aA]([\\.0123456789ABCDEFHIJKLMNOPQRSTUVWXYZ_abcdefhijklmnopqrstuvwxyz-][A-Za-z0-9._-]{7}|[gG][\\.0123456789ABCDFGHIJKLMNOPQRSTUVWXYZ_abcdfghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{6}|[gG][eE][\\.0123456789ABCDEFGHIJKLMOPQRSTUVWXYZ_abcdefghijklmopqrstuvwxyz-][A-Za-z0-9._-]{5}|[gG][eE][nN][\\.0123456789ABCDEFGHIJKLMNOPQRSUVWXYZ_abcdefghijklmnopqrsuvwxyz-][A-Za-z0-9._-]{4}|[gG][eE][nN][tT][\\.0123456789ABCDEFGHIJKLMNOPQRTUVWXYZ_abcdefghijklmnopqrtuvwxyz-][A-Za-z0-9._-]{3}|[gG][eE][nN][tT][sS][0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{2}|[gG][eE][nN][tT][sS]\\.[\\.0123456789ABCDEFGHIJKLNOPQRSTUVWXYZ_abcdefghijklnopqrstuvwxyz-][A-Za-z0-9._-]{1}|[gG][eE][nN][tT][sS]\\.[mM][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-])|[cC]([\\.0123456789ABCDEFGHIJKMNOPQRSTUVWXYZ_abcdefghijkmnopqrstuvwxyz-][A-Za-z0-9._-]{7}|[lL][\\.0123456789BCDEFGHIJKLMNOPQRSTUVWXYZ_bcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{6}|[lL][aA][\\.0123456789ABCDEFGHIJKLMNOPQRSTVWXYZ_abcdefghijklmnopqrstvwxyz-][A-Za-z0-9._-]{5}|[lL][aA][uU][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{4}|[lL][aA][uU][dD][\\.0123456789ABCDFGHIJKLMNOPQRSTUVWXYZ_abcdfghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{3}|[lL][aA][uU][dD][eE][0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{2}|[lL][aA][uU][dD][eE]\\.[\\.0123456789ABCDEFGHIJKLNOPQRSTUVWXYZ_abcdefghijklnopqrstuvwxyz-][A-Za-z0-9._-]{1}|[lL][aA][uU][dD][eE]\\.[mM][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-])|\\.(cargo|gitignore|helmignore|dockerignore|gitattributes|editorconfig|golangci\\.ya?ml))(/([A-Za-z0-9_][A-Za-z0-9._-]{0,7}|[A-Za-z0-9_][A-Za-z0-9._-]{9,99}|[0123456789BDEFGHIJKLMNOPQRSTUVWXYZ_bdefghijklmnopqrstuvwxyz][A-Za-z0-9._-]{8}|[aA]([\\.0123456789ABCDEFHIJKLMNOPQRSTUVWXYZ_abcdefhijklmnopqrstuvwxyz-][A-Za-z0-9._-]{7}|[gG][\\.0123456789ABCDFGHIJKLMNOPQRSTUVWXYZ_abcdfghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{6}|[gG][eE][\\.0123456789ABCDEFGHIJKLMOPQRSTUVWXYZ_abcdefghijklmopqrstuvwxyz-][A-Za-z0-9._-]{5}|[gG][eE][nN][\\.0123456789ABCDEFGHIJKLMNOPQRSUVWXYZ_abcdefghijklmnopqrsuvwxyz-][A-Za-z0-9._-]{4}|[gG][eE][nN][tT][\\.0123456789ABCDEFGHIJKLMNOPQRTUVWXYZ_abcdefghijklmnopqrtuvwxyz-][A-Za-z0-9._-]{3}|[gG][eE][nN][tT][sS][0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{2}|[gG][eE][nN][tT][sS]\\.[\\.0123456789ABCDEFGHIJKLNOPQRSTUVWXYZ_abcdefghijklnopqrstuvwxyz-][A-Za-z0-9._-]{1}|[gG][eE][nN][tT][sS]\\.[mM][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-])|[cC]([\\.0123456789ABCDEFGHIJKMNOPQRSTUVWXYZ_abcdefghijkmnopqrstuvwxyz-][A-Za-z0-9._-]{7}|[lL][\\.0123456789BCDEFGHIJKLMNOPQRSTUVWXYZ_bcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{6}|[lL][aA][\\.0123456789ABCDEFGHIJKLMNOPQRSTVWXYZ_abcdefghijklmnopqrstvwxyz-][A-Za-z0-9._-]{5}|[lL][aA][uU][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{4}|[lL][aA][uU][dD][\\.0123456789ABCDFGHIJKLMNOPQRSTUVWXYZ_abcdfghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{3}|[lL][aA][uU][dD][eE][0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{2}|[lL][aA][uU][dD][eE]\\.[\\.0123456789ABCDEFGHIJKLNOPQRSTUVWXYZ_abcdefghijklnopqrstuvwxyz-][A-Za-z0-9._-]{1}|[lL][aA][uU][dD][eE]\\.[mM][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-])|\\.(cargo|gitignore|helmignore|dockerignore|gitattributes|editorconfig|golangci\\.ya?ml)))*/?$"
          },
          "minItems": 1
        },
        "depends_on": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 27,
            "maxLength": 30,
            "pattern": "^falcone-serverless:[A-Z]{2,4}-[0-9]{2}\\.t[0-9]{1,2}$"
          }
        },
        "risks": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "proposed_risk": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3"
          ]
        },
        "risk_rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "size": {
          "enum": [
            "S",
            "M"
          ]
        },
        "estimated_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "rollout": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "kill_switch": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "open_questions": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1
        }
      }
    },
    "story_amendment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "sources",
        "changes"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "sources": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1
        },
        "changes": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "action",
              "target",
              "text"
            ],
            "properties": {
              "section": {
                "enum": [
                  "acceptance_criteria",
                  "requirements",
                  "dependencies",
                  "scope",
                  "notes"
                ]
              },
              "action": {
                "enum": [
                  "ADD",
                  "REPLACE",
                  "REMOVE"
                ]
              },
              "target": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "text": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "minItems": 1
        }
      }
    }
  }
}
