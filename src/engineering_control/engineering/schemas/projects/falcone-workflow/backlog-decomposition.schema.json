{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "inputs",
    "frame",
    "stories"
  ],
  "properties": {
    "schema": {
      "const": "backlog-decomposition-v1"
    },
    "project": {
      "const": "falcone-workflow"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha",
        "design_sha256",
        "backlog_sha256",
        "issues_sha256"
      ],
      "properties": {
        "source_sha": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[a-f0-9]{40}$"
        },
        "design_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "backlog_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "issues_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "frame": {
      "$ref": "#/$defs/frame"
    },
    "stories": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/plan_story"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contracts",
        "global_decisions"
      ],
      "properties": {
        "contracts": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/contract"
          },
          "minItems": 1
        },
        "global_decisions": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner_repository",
        "kind",
        "path",
        "summary",
        "consumers",
        "provider_stories",
        "consumer_stories",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 48,
          "pattern": "^ctr-[a-z0-9][a-z0-9-]{0,43}$"
        },
        "owner_repository": {
          "enum": [
            "gntik-ai/falcone-workflow",
            "gntik-ai/falcone",
            "gntik-ai/falcone-charts"
          ]
        },
        "kind": {
          "enum": [
            "wit",
            "http-api",
            "event",
            "helm-values",
            "metric",
            "config"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^([A-Za-z0-9_][A-Za-z0-9._-]{0,7}|[A-Za-z0-9_][A-Za-z0-9._-]{9,99}|[0123456789BDEFGHIJKLMNOPQRSTUVWXYZ_bdefghijklmnopqrstuvwxyz][A-Za-z0-9._-]{8}|[aA]([\\.0123456789ABCDEFHIJKLMNOPQRSTUVWXYZ_abcdefhijklmnopqrstuvwxyz-][A-Za-z0-9._-]{7}|[gG][\\.0123456789ABCDFGHIJKLMNOPQRSTUVWXYZ_abcdfghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{6}|[gG][eE][\\.0123456789ABCDEFGHIJKLMOPQRSTUVWXYZ_abcdefghijklmopqrstuvwxyz-][A-Za-z0-9._-]{5}|[gG][eE][nN][\\.0123456789ABCDEFGHIJKLMNOPQRSUVWXYZ_abcdefghijklmnopqrsuvwxyz-][A-Za-z0-9._-]{4}|[gG][eE][nN][tT][\\.0123456789ABCDEFGHIJKLMNOPQRTUVWXYZ_abcdefghijklmnopqrtuvwxyz-][A-Za-z0-9._-]{3}|[gG][eE][nN][tT][sS][0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{2}|[gG][eE][nN][tT][sS]\\.[\\.0123456789ABCDEFGHIJKLNOPQRSTUVWXYZ_abcdefghijklnopqrstuvwxyz-][A-Za-z0-9._-]{1}|[gG][eE][nN][tT][sS]\\.[mM][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-])|[cC]([\\.0123456789ABCDEFGHIJKMNOPQRSTUVWXYZ_abcdefghijkmnopqrstuvwxyz-][A-Za-z0-9._-]{7}|[lL][\\.0123456789BCDEFGHIJKLMNOPQRSTUVWXYZ_bcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{6}|[lL][aA][\\.0123456789ABCDEFGHIJKLMNOPQRSTVWXYZ_abcdefghijklmnopqrstvwxyz-][A-Za-z0-9._-]{5}|[lL][aA][uU][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{4}|[lL][aA][uU][dD][\\.0123456789ABCDFGHIJKLMNOPQRSTUVWXYZ_abcdfghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{3}|[lL][aA][uU][dD][eE][0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{2}|[lL][aA][uU][dD][eE]\\.[\\.0123456789ABCDEFGHIJKLNOPQRSTUVWXYZ_abcdefghijklnopqrstuvwxyz-][A-Za-z0-9._-]{1}|[lL][aA][uU][dD][eE]\\.[mM][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-])|\\.(cargo|gitignore|helmignore|dockerignore|gitattributes|editorconfig|golangci\\.ya?ml))(/([A-Za-z0-9_][A-Za-z0-9._-]{0,7}|[A-Za-z0-9_][A-Za-z0-9._-]{9,99}|[0123456789BDEFGHIJKLMNOPQRSTUVWXYZ_bdefghijklmnopqrstuvwxyz][A-Za-z0-9._-]{8}|[aA]([\\.0123456789ABCDEFHIJKLMNOPQRSTUVWXYZ_abcdefhijklmnopqrstuvwxyz-][A-Za-z0-9._-]{7}|[gG][\\.0123456789ABCDFGHIJKLMNOPQRSTUVWXYZ_abcdfghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{6}|[gG][eE][\\.0123456789ABCDEFGHIJKLMOPQRSTUVWXYZ_abcdefghijklmopqrstuvwxyz-][A-Za-z0-9._-]{5}|[gG][eE][nN][\\.0123456789ABCDEFGHIJKLMNOPQRSUVWXYZ_abcdefghijklmnopqrsuvwxyz-][A-Za-z0-9._-]{4}|[gG][eE][nN][tT][\\.0123456789ABCDEFGHIJKLMNOPQRTUVWXYZ_abcdefghijklmnopqrtuvwxyz-][A-Za-z0-9._-]{3}|[gG][eE][nN][tT][sS][0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{2}|[gG][eE][nN][tT][sS]\\.[\\.0123456789ABCDEFGHIJKLNOPQRSTUVWXYZ_abcdefghijklnopqrstuvwxyz-][A-Za-z0-9._-]{1}|[gG][eE][nN][tT][sS]\\.[mM][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-])|[cC]([\\.0123456789ABCDEFGHIJKMNOPQRSTUVWXYZ_abcdefghijkmnopqrstuvwxyz-][A-Za-z0-9._-]{7}|[lL][\\.0123456789BCDEFGHIJKLMNOPQRSTUVWXYZ_bcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{6}|[lL][aA][\\.0123456789ABCDEFGHIJKLMNOPQRSTVWXYZ_abcdefghijklmnopqrstvwxyz-][A-Za-z0-9._-]{5}|[lL][aA][uU][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{4}|[lL][aA][uU][dD][\\.0123456789ABCDFGHIJKLMNOPQRSTUVWXYZ_abcdfghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{3}|[lL][aA][uU][dD][eE][0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{2}|[lL][aA][uU][dD][eE]\\.[\\.0123456789ABCDEFGHIJKLNOPQRSTUVWXYZ_abcdefghijklnopqrstuvwxyz-][A-Za-z0-9._-]{1}|[lL][aA][uU][dD][eE]\\.[mM][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-])|\\.(cargo|gitignore|helmignore|dockerignore|gitattributes|editorconfig|golangci\\.ya?ml)))*/?$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "consumers": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "enum": [
              "gntik-ai/falcone-workflow",
              "gntik-ai/falcone",
              "gntik-ai/falcone-charts"
            ]
          },
          "minItems": 1
        },
        "provider_stories": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 7,
            "pattern": "^[A-Z]{2,4}-[0-9]{2}$"
          }
        },
        "consumer_stories": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 7,
            "pattern": "^[A-Z]{2,4}-[0-9]{2}$"
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1
        }
      }
    },
    "plan_story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "story_id",
        "story_issue",
        "epic_issue",
        "part_id",
        "tasks",
        "story_amendment"
      ],
      "properties": {
        "story_id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 7,
          "pattern": "^[A-Z]{2,4}-[0-9]{2}$"
        },
        "story_issue": {
          "type": "integer",
          "minimum": 1
        },
        "epic_issue": {
          "type": "integer",
          "minimum": 1
        },
        "part_id": {
          "type": "string",
          "minLength": 21,
          "maxLength": 21,
          "pattern": "^ep[0-9]{2}-[a-f0-9]{16}$"
        },
        "tasks": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/task"
          },
          "minItems": 1
        },
        "story_amendment": {
          "anyOf": [
            {
              "$ref": "#/$defs/story_amendment"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "kind",
        "target",
        "why",
        "what_changes",
        "out_of_scope",
        "acceptance_criteria",
        "requirements",
        "interfaces",
        "test_commands",
        "paths",
        "depends_on",
        "risks",
        "proposed_risk",
        "risk_rationale",
        "size",
        "estimated_files",
        "rollout",
        "kill_switch",
        "open_questions",
        "sources"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 25,
          "maxLength": 28,
          "pattern": "^falcone-workflow:[A-Z]{2,4}-[0-9]{2}\\.t[0-9]{1,2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9._:/@+ =,\"'-]{1,100}$"
        },
        "kind": {
          "enum": [
            "feature",
            "enhancement",
            "bug",
            "chore"
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "role",
                "component"
              ],
              "properties": {
                "repository": {
                  "const": "gntik-ai/falcone-workflow"
                },
                "role": {
                  "const": "source"
                },
                "component": {
                  "enum": [
                    "engine",
                    "worker"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "role",
                "component"
              ],
              "properties": {
                "repository": {
                  "const": "gntik-ai/falcone"
                },
                "role": {
                  "const": "source"
                },
                "component": {
                  "enum": [
                    "workflow-facade",
                    "routing",
                    "console",
                    "quotas",
                    "admission"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "role",
                "component"
              ],
              "properties": {
                "repository": {
                  "const": "gntik-ai/falcone-charts"
                },
                "role": {
                  "const": "deployment"
                },
                "component": {
                  "enum": [
                    "chart"
                  ]
                }
              }
            }
          ]
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "what_changes": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "minItems": 1
        },
        "out_of_scope": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion",
              "covers"
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "covers": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "minLength": 9,
                  "maxLength": 12,
                  "pattern": "^[A-Z]{2,4}-[0-9]{2}#ac[0-9]{1,2}$"
                }
              }
            }
          },
          "minItems": 1
        },
        "requirements": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 19,
            "pattern": "^FR-[A-Za-z0-9][A-Za-z0-9.-]{0,15}$"
          }
        },
        "interfaces": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provides",
            "consumes"
          ],
          "properties": {
            "provides": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 48,
                "pattern": "^ctr-[a-z0-9][a-z0-9-]{0,43}$"
              }
            },
            "consumes": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 48,
                "pattern": "^ctr-[a-z0-9][a-z0-9-]{0,43}$"
              }
            }
          }
        },
        "test_commands": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "minItems": 1
        },
        "paths": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^([A-Za-z0-9_][A-Za-z0-9._-]{0,7}|[A-Za-z0-9_][A-Za-z0-9._-]{9,99}|[0123456789BDEFGHIJKLMNOPQRSTUVWXYZ_bdefghijklmnopqrstuvwxyz][A-Za-z0-9._-]{8}|[aA]([\\.0123456789ABCDEFHIJKLMNOPQRSTUVWXYZ_abcdefhijklmnopqrstuvwxyz-][A-Za-z0-9._-]{7}|[gG][\\.0123456789ABCDFGHIJKLMNOPQRSTUVWXYZ_abcdfghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{6}|[gG][eE][\\.0123456789ABCDEFGHIJKLMOPQRSTUVWXYZ_abcdefghijklmopqrstuvwxyz-][A-Za-z0-9._-]{5}|[gG][eE][nN][\\.0123456789ABCDEFGHIJKLMNOPQRSUVWXYZ_abcdefghijklmnopqrsuvwxyz-][A-Za-z0-9._-]{4}|[gG][eE][nN][tT][\\.0123456789ABCDEFGHIJKLMNOPQRTUVWXYZ_abcdefghijklmnopqrtuvwxyz-][A-Za-z0-9._-]{3}|[gG][eE][nN][tT][sS][0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{2}|[gG][eE][nN][tT][sS]\\.[\\.0123456789ABCDEFGHIJKLNOPQRSTUVWXYZ_abcdefghijklnopqrstuvwxyz-][A-Za-z0-9._-]{1}|[gG][eE][nN][tT][sS]\\.[mM][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-])|[cC]([\\.0123456789ABCDEFGHIJKMNOPQRSTUVWXYZ_abcdefghijkmnopqrstuvwxyz-][A-Za-z0-9._-]{7}|[lL][\\.0123456789BCDEFGHIJKLMNOPQRSTUVWXYZ_bcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{6}|[lL][aA][\\.0123456789ABCDEFGHIJKLMNOPQRSTVWXYZ_abcdefghijklmnopqrstvwxyz-][A-Za-z0-9._-]{5}|[lL][aA][uU][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{4}|[lL][aA][uU][dD][\\.0123456789ABCDFGHIJKLMNOPQRSTUVWXYZ_abcdfghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{3}|[lL][aA][uU][dD][eE][0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{2}|[lL][aA][uU][dD][eE]\\.[\\.0123456789ABCDEFGHIJKLNOPQRSTUVWXYZ_abcdefghijklnopqrstuvwxyz-][A-Za-z0-9._-]{1}|[lL][aA][uU][dD][eE]\\.[mM][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-])|\\.(cargo|gitignore|helmignore|dockerignore|gitattributes|editorconfig|golangci\\.ya?ml))(/([A-Za-z0-9_][A-Za-z0-9._-]{0,7}|[A-Za-z0-9_][A-Za-z0-9._-]{9,99}|[0123456789BDEFGHIJKLMNOPQRSTUVWXYZ_bdefghijklmnopqrstuvwxyz][A-Za-z0-9._-]{8}|[aA]([\\.0123456789ABCDEFHIJKLMNOPQRSTUVWXYZ_abcdefhijklmnopqrstuvwxyz-][A-Za-z0-9._-]{7}|[gG][\\.0123456789ABCDFGHIJKLMNOPQRSTUVWXYZ_abcdfghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{6}|[gG][eE][\\.0123456789ABCDEFGHIJKLMOPQRSTUVWXYZ_abcdefghijklmopqrstuvwxyz-][A-Za-z0-9._-]{5}|[gG][eE][nN][\\.0123456789ABCDEFGHIJKLMNOPQRSUVWXYZ_abcdefghijklmnopqrsuvwxyz-][A-Za-z0-9._-]{4}|[gG][eE][nN][tT][\\.0123456789ABCDEFGHIJKLMNOPQRTUVWXYZ_abcdefghijklmnopqrtuvwxyz-][A-Za-z0-9._-]{3}|[gG][eE][nN][tT][sS][0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{2}|[gG][eE][nN][tT][sS]\\.[\\.0123456789ABCDEFGHIJKLNOPQRSTUVWXYZ_abcdefghijklnopqrstuvwxyz-][A-Za-z0-9._-]{1}|[gG][eE][nN][tT][sS]\\.[mM][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-])|[cC]([\\.0123456789ABCDEFGHIJKMNOPQRSTUVWXYZ_abcdefghijkmnopqrstuvwxyz-][A-Za-z0-9._-]{7}|[lL][\\.0123456789BCDEFGHIJKLMNOPQRSTUVWXYZ_bcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{6}|[lL][aA][\\.0123456789ABCDEFGHIJKLMNOPQRSTVWXYZ_abcdefghijklmnopqrstvwxyz-][A-Za-z0-9._-]{5}|[lL][aA][uU][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{4}|[lL][aA][uU][dD][\\.0123456789ABCDFGHIJKLMNOPQRSTUVWXYZ_abcdfghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{3}|[lL][aA][uU][dD][eE][0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz-][A-Za-z0-9._-]{2}|[lL][aA][uU][dD][eE]\\.[\\.0123456789ABCDEFGHIJKLNOPQRSTUVWXYZ_abcdefghijklnopqrstuvwxyz-][A-Za-z0-9._-]{1}|[lL][aA][uU][dD][eE]\\.[mM][\\.0123456789ABCEFGHIJKLMNOPQRSTUVWXYZ_abcefghijklmnopqrstuvwxyz-])|\\.(cargo|gitignore|helmignore|dockerignore|gitattributes|editorconfig|golangci\\.ya?ml)))*/?$"
          },
          "minItems": 1
        },
        "depends_on": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 14,
            "maxLength": 57,
            "pattern": "^(falcone-workflow:[A-Z]{2,4}-[0-9]{2}\\.t[0-9]{1,2}|contract:ctr-[a-z0-9][a-z0-9-]{0,43})$"
          }
        },
        "risks": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "proposed_risk": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3"
          ]
        },
