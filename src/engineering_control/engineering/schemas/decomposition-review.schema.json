{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "project",
    "inputs",
    "review",
    "blockers"
  ],
  "properties": {
    "status": {
      "enum": [
        "COMPLETE",
        "BLOCKED"
      ]
    },
    "project": {
      "const": "falcone-serverless"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha",
        "design_sha256",
        "backlog_sha256",
        "issues_sha256",
        "frame_sha256",
        "part_id",
        "draft_sha256"
      ],
      "properties": {
        "source_sha": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 40,
              "maxLength": 40,
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "design_sha256": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "backlog_sha256": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "issues_sha256": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "frame_sha256": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "part_id": {
          "type": "string",
          "minLength": 21,
          "maxLength": 22,
          "pattern": "^(frame|ep[0-9]{2})-[a-f0-9]{16}$"
        },
        "draft_sha256": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/review"
        },
        {
          "type": "null"
        }
      ]
    },
    "blockers": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "pattern": "^[ -~]*$"
      }
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "summary",
        "findings"
      ],
      "properties": {
        "decision": {
          "enum": [
            "APPROVE",
            "REVISE"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500,
          "pattern": "^[ -~]*$"
        },
        "findings": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "subject",
              "detail",
              "reference"
            ],
            "properties": {
              "category": {
                "enum": [
                  "uncovered_criterion",
                  "uncovered_requirement",
                  "repository_ownership",
                  "contract",
                  "dependency",
                  "size_bounds",
                  "forbidden_path",
                  "test_environment",
                  "risk",
                  "unsupported_claim",
                  "story_amendment",
                  "duplicate_task",
                  "other"
                ]
              },
              "subject": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[ -~]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600,
                "pattern": "^[ -~]*$"
              },
              "reference": {
                "type": "string",
                "minLength": 0,
                "maxLength": 200,
                "pattern": "^[ -~]*$"
              }
            }
          }
        }
      }
    }
  }
}
