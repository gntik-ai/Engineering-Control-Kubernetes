{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "summary",
    "dependency_resolution",
    "changed_files",
    "tests",
    "open_questions",
    "page_id",
    "blueprint_sha256",
    "api_calls",
    "kit",
    "i18n",
    "states",
    "viewports",
    "test_skips",
    "spec_deviations"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "BLOCKED",
        "DEPENDENCIES_REQUIRED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "dependency_resolution": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ecosystem",
          "directory"
        ],
        "properties": {
          "ecosystem": {
            "type": "string",
            "enum": [
              "go",
              "pnpm"
            ]
          },
          "directory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "changed_files": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "tests": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "status"
        ],
        "properties": {
          "command": {
            "type": "string",
            "maxLength": 4000
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "SKIPPED"
            ]
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "page_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
    },
    "blueprint_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "api_calls": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "method",
          "path",
          "payload_shape",
          "legacy_ref",
          "new_ref",
          "identical"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 300
          },
          "payload_shape": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "legacy_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "new_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "identical": {
            "type": "boolean"
          }
        }
      }
    },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "blocks",
        "components",
        "validate_page",
        "validate_page_errors",
        "validate_page_note",
        "explicit_props"
      ],
      "properties": {
        "template": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocks": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
          }
        },
        "components": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
          }
        },
        "validate_page": {
          "enum": [
            "CLEAN",
            "FINDINGS",
            "NOT_RUN"
          ]
        },
        "validate_page_errors": {
          "type": "integer",
          "minimum": 0
        },
        "validate_page_note": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "explicit_props": {
          "type": "boolean"
        }
      }
    },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "keys",
        "locales",
        "missing_keys"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9.-]{0,99}$"
        },
        "keys": {
          "type": "integer",
          "minimum": 0
        },
        "locales": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "enum": [
              "es",
              "en"
            ]
          }
        },
        "missing_keys": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "states": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "implemented",
          "ref"
        ],
        "properties": {
          "state": {
            "enum": [
              "loading",
              "empty",
              "error-401",
              "error-403",
              "error-404",
              "error-500",
              "network-error",
              "workspace-required",
              "restricted"
            ]
          },
          "implemented": {
            "type": "boolean"
          },
          "ref": {
            "type": "string",
            "minLength": 0,
            "maxLength": 300
          }
        }
      }
    },
    "viewports": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "viewport",
          "status",
          "evidence"
        ],
        "properties": {
          "viewport": {
            "enum": [
              "mobile",
              "tablet",
              "desktop"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIPPED"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 0,
            "maxLength": 300
          }
        }
      },
      "minItems": 3
    },
    "test_skips": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "reason",
          "detail"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "reason": {
            "enum": [
              "REQUIRES_DOCKER",
              "REQUIRES_NETWORK",
              "REQUIRES_BROWSER_RUNTIME",
              "OTHER"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "spec_deviations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  }
}
