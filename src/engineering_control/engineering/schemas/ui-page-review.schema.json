{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "summary",
    "page_id",
    "review_context",
    "hard_rules",
    "checks",
    "findings",
    "evidence",
    "open_questions"
  ],
  "properties": {
    "decision": {
      "enum": [
        "PASS",
        "REQUEST_CHANGES",
        "BLOCKED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "page_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
    },
    "review_context": {
      "enum": [
        "delivery",
        "flow_c_visual"
      ]
    },
    "hard_rules": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "rule": {
            "enum": [
              "api-call-parity",
              "scope-no-backend-legacy-contract-change",
              "kit-only-styling",
              "no-sample-data-fallback",
              "i18n-complete",
              "tests-present",
              "environment-skips-reported"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        }
      },
      "minItems": 7
    },
    "checks": {
      "type": "array",
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "check": {
            "enum": [
              "spec-conformance",
              "data",
              "action",
              "error-empty",
              "accessibility",
              "kit-conformance",
              "runtime-health",
              "responsive",
              "visual-review",
              "i18n",
              "tests"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_EVALUATED",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        }
      },
      "minItems": 11
    },
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "severity",
          "blocking",
          "title",
          "detail",
          "location",
          "viewport",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[0-9]{1,3}$"
          },
          "type": {
            "enum": [
              "BUG_NEW_UI",
              "BUG_LEGACY",
              "BACKEND_GAP",
              "KIT_GAP",
              "IMPROVEMENT"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "location": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "viewport": {
            "anyOf": [
              {
                "enum": [
                  "mobile",
                  "tablet",
                  "desktop"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "minItems": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reference",
          "sha256"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "open_questions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    }
  }
}
