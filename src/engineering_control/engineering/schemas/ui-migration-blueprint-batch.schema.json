{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "mode",
    "project",
    "inputs",
    "batch",
    "review",
    "blockers"
  ],
  "properties": {
    "status": {
      "enum": [
        "COMPLETE",
        "BLOCKED"
      ]
    },
    "mode": {
      "enum": [
        "draft",
        "review"
      ]
    },
    "project": {
      "enum": [
        "falcone",
        "musematic",
        "llmwiki"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_sha256",
        "legacy_source_sha",
        "gntik_ui_version",
        "kit_source",
        "kit_snapshot_sha256",
        "draft_sha256",
        "part_id"
      ],
      "properties": {
        "inventory_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "legacy_source_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{7,40}$"
        },
        "gntik_ui_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 100
        },
        "kit_source": {
          "enum": [
            "mcp",
            "snapshot"
          ]
        },
        "kit_snapshot_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "draft_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "part_id": {
          "type": "string",
          "pattern": "^(frame|b[0-9]{3})-[a-f0-9]{16}$"
        }
      }
    },
    "batch": {
      "anyOf": [
        {
          "$ref": "#/$defs/batch"
        },
        {
          "type": "null"
        }
      ]
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/review"
        },
        {
          "type": "null"
        }
      ]
    },
    "blockers": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "$defs": {
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages",
        "gaps"
      ],
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "$ref": "#/$defs/page_judgement"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part_gap"
          },
          "maxItems": 100
        }
      }
    },
    "page_judgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "disposition",
        "disposition_reason",
        "target",
        "behaviour",
        "i18n",
        "wave",
        "parity_acceptance",
        "gap_ids",
        "depends_on"
      ],
      "properties": {
        "page_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
        },
        "disposition": {
          "enum": [
            "MIGRATE",
            "WRAP",
            "DELETE"
          ]
        },
        "disposition_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "template",
            "layout",
            "blocks",
            "components",
            "wrapped",
            "justification"
          ],
          "properties": {
            "template": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "layout": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "blocks": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
              }
            },
            "components": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
              }
            },
            "wrapped": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "justification": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        "behaviour": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actions",
            "validations",
            "permissions",
            "states"
          ],
          "properties": {
            "actions": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "trigger",
                  "endpoint_refs",
                  "permission"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "trigger": {
                    "enum": [
                      "button",
                      "menu",
                      "form-submit",
                      "link",
                      "keyboard",
                      "on-load"
                    ]
                  },
                  "endpoint_refs": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "permission": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "validations": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "rule"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "rule": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            },
            "permissions": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "guard",
                  "rule"
                ],
                "properties": {
                  "guard": {
                    "enum": [
                      "public",
                      "auth",
                      "SA",
                      "PO",
                      "WS-sec",
                      "in-page",
                      "nav"
                    ]
                  },
                  "rule": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            },
            "states": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "expected"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "loading",
                      "empty",
                      "error-401",
                      "error-403",
                      "error-404",
                      "error-500",
                      "network-error",
                      "workspace-required",
                      "restricted"
                    ]
                  },
                  "expected": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "wave": {
          "anyOf": [
            {
              "enum": [
                "u1",
                "u2",
                "u3",
                "u4"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "parity_acceptance": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check",
              "criterion",
              "fixtures"
            ],
            "properties": {
              "check": {
                "enum": [
                  "data",
                  "action",
                  "error-empty",
                  "accessibility",
                  "kit-conformance",
                  "runtime-health",
                  "responsive",
                  "visual-review"
                ]
              },
              "criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "fixtures": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          }
        },
        "gap_ids": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "pattern": "^gap-[a-z0-9][a-z0-9-]{0,63}$"
          }
        },
        "depends_on": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "i18n": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "string_scope",
            "estimated_strings"
          ],
          "properties": {
            "string_scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "estimated_strings": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "part_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "target_repository",
        "summary",
        "evidence",
        "blocks",
        "interim",
        "seed_ref",
        "cutover_resolution",
        "cutover_reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^gap-[a-z0-9][a-z0-9-]{0,63}$"
        },
        "type": {
          "enum": [
            "BACKEND_GAP",
            "KIT_GAP"
          ]
        },
        "target_repository": {
          "enum": [
            "gntik-ai/falcone",
            "gntik-ai/gntik-ui"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidence": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "minItems": 1
        },
        "blocks": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^(u0-[a-z0-9][a-z0-9-]{0,63}|u5-cutover|[a-z0-9][a-z0-9-]{0,99})$",
            "maxLength": 100
          }
        },
        "interim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "seed_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "cutover_resolution": {
          "enum": [
            "RESOLVED",
            "DEFERRED"
          ]
        },
        "cutover_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "summary",
        "findings"
      ],
      "properties": {
        "decision": {
          "enum": [
            "APPROVE",
            "REVISE"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "findings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "subject",
              "detail",
              "reference"
            ],
            "properties": {
              "category": {
                "enum": [
                  "invented_endpoint",
                  "invented_kit_item",
                  "missing_page",
                  "dead_module_migrated",
                  "wave_order",
                  "behaviour_gap",
                  "parity_criteria",
                  "gap_classification",
                  "foundation_epic",
                  "other"
                ]
              },
              "subject": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "reference": {
                "type": "string",
                "minLength": 0,
                "maxLength": 300
              }
            }
          }
        }
      }
    }
  }
}
